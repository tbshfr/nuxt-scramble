{
  "name": "nuxt-scramble",
  "version": "0.2.2",
  "description": "Nuxt module that obfuscates emails, phone numbers and custom text in HTML to make scraping harder",
  "repository": "tbshfr/nuxt-scramble",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run test:e2e && changelogen --release --push",
    "release:major": "pnpm run lint && pnpm run test && pnpm run test:e2e && changelogen --release --clean --push --major",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.0"
  },
  "devDependencies": {
    "@nuxt/content": "^3.16.1",
    "@nuxt/devtools": "^3.4.2",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.12.0",
    "nuxt": "^4.6.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@11.1.2"
}
